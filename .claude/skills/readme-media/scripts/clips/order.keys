# Onto the orders while the pointer goes to By state, the whole screen for the click, since the rows
# move at once and the widget is at the other side, then the widget's new order up close. The same
# for the blocks: onto them for the drag, the whole screen by the release, then the widget.
@order-1.0     0 0 2304
@order+0.4     0 0 2304
@order+1.4     0 170 1600
@state-0.9     0 170 1600
@state-0.1     0 0 2304
@state+0.5     0 0 2304
@state+1.5     704 0 1600
@state+2.6     704 0 1600
@state+3.4     0 0 2304
@scrolled-0.6  0 0 2304
@scrolled+0.4  0 400 1600
@drag-1.2      0 400 1600
@drag-0.3      0 0 2304
@drag+0.4      0 0 2304
@drag+1.4      704 0 1600
@drag+2.6      704 0 1600
@drag+3.4      0 0 2304
